revolverUpgrade.ACCURACY.name=精準
revolverUpgrade.POWER.name=威力
revolverUpgrade.SILVER.name=銀彈
revolverUpgrade.POISONED.name=猛毒
revolverUpgrade.BANE_OF_ATROPODS.name=節肢殺手
revolverUpgrade.BANE_OF_ELDRITCH.name=異域殺手
